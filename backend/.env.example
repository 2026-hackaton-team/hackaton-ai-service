# Default: no AI key, no network call, no database.
AI_PROVIDER=mock
# Optional real model mode. Pick a model your API project can use.
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=25
# Explicit origins only; do not use * with credentialed browser requests.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5180,http://localhost:5180

# General data/auth CRUD remains browser-local until backend integration.
VITE_API_ENABLED=false
VITE_API_BASE_URL=/api
# AI integration: dev defaults to server, production defaults to browser local.
# npm run dev:demo explicitly selects server and starts FastAPI + Vite together.
VITE_AI_MODE=local
VITE_AI_API_BASE_URL=/api
# Dev/preview proxy only. Production needs a separately deployed HTTPS backend.
MAEUM_API_TARGET=http://127.0.0.1:8000
# VITE_* values are public browser configuration. Never put passwords, API keys,
# database credentials, signing keys, or AI provider secrets here.
